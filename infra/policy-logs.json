{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": [
        "arn:aws:logs:ap-northeast-2:__ACCOUNT_ID__:log-group:/aws/lambda/team06-api:*",
        "arn:aws:logs:ap-northeast-2:__ACCOUNT_ID__:log-group:/aws/lambda/team06-worker:*"
      ]
    }
  ]
}
