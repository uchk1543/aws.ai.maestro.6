{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadAndOcrCache",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": ["arn:aws:s3:::__BUCKET__/cache/read/*", "arn:aws:s3:::__BUCKET__/cache/ocr/*"]
    },
    {
      "Sid": "MissingCacheKeyIs404",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::__BUCKET__"
    }
  ]
}
