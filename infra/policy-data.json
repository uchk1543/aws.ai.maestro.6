{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "JobsTable",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:UpdateItem"],
      "Resource": "arn:aws:dynamodb:ap-northeast-2:__ACCOUNT_ID__:table/team06-jobs"
    },
    {
      "Sid": "HsHistory",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:UpdateItem"],
      "Resource": "arn:aws:dynamodb:ap-northeast-2:__ACCOUNT_ID__:table/team06-hs-history"
    },
    {
      "Sid": "Wms",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:UpdateItem", "dynamodb:Scan"],
      "Resource": "arn:aws:dynamodb:ap-northeast-2:__ACCOUNT_ID__:table/team06-wms"
    },
    {
      "Sid": "Shipments",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:UpdateItem", "dynamodb:Scan"],
      "Resource": "arn:aws:dynamodb:ap-northeast-2:__ACCOUNT_ID__:table/team06-shipments"
    },
    {
      "Sid": "UploadedDocuments",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::__BUCKET__/uploads/*"
    }
  ]
}
